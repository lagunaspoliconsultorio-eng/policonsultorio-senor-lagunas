n2onr6 xlyipyv xuxw1ft x1rg5ohu x1jchvi3 xjb2p0i xo1l8bm x17mssa0 x1ic7a3i xnpuxes" style="min-height: 0px;">Jhonda</span></div></div></div><div class="xhslqc4 x1c4vz4f x2lah0s x1pg5gke xdzw4kq x193iq5w x1xxsxie x7r5mf7 x6ikm8r x10wlt62 xlyipyv xuxw1ft" data-testid="cell-frame-primary-detail"><span class="x140p0ai x1gufx9m x1s928wv xhkezso x1gmr53x x1cpjm7i x1fgarty x1943h6x x193iq5w xeuugli x13faqbe x1vvkbs x1lliihq x1fj9vlw xhslqc4 x1hx0egp x1pg5gke xjb2p0i xo1l8bm xl2ypbo x1ic7a3i" style="--x-fontSize: 12px; --x-lineHeight: 8.5313px; --x-8dd7yt: -0.0137em; --x-hxtmnb: 0.0137em;">3:31 p.m.</span></div></div><div class="x6s0dn4 xhslqc4 x78zum5 x1nxh6w3 x1fc57z9 xr9ek0c xisnujt" data-testid="cell-frame-secondary"><div class="xjbqb8w x1iyjqo2 x1f6kntn x1fc57z9 x6ikm8r x10wlt62 x1yc453h xlyipyv xuxw1ft xo1l8bm"><span class="x78zum5 x1cy8zhl" title="‪&lt;!DOCTYPE html&gt;
&lt;html lang=&quot;es&quot;&gt;
&lt;head&gt;
&lt;meta charset=&quot;UTF-8&quot;&gt;
&lt;meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot;&gt;
&lt;title&gt;Nosotros | Clínica Señor de Lagunas&lt;/title&gt;

&lt;style&gt;
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    font-family:Arial, Helvetica, sans-serif;
    background:#bfe8f7;
}

@keyframes fadeIn {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
}

@keyframes entrada{
    from{
        opacity:0;
        transform:translateY(20px);
    }
    to{
        opacity:1;
        transform:translateY(0);
    }
}

.pagina{
    min-height:100vh;
    padding:35px 45px 70px;
    position:relative;
    overflow:hidden;
    background:
        radial-gradient(circle at 8% 10%,rgba(255,255,255,.9),transparent 25%),
        radial-gradient(circle at 90% 90%,rgba(0,126,190,.2),transparent 35%),
        repeating-linear-gradient(
            135deg,
            transparent 0px,
            transparent 55px,
            rgba(7,85,160,.035) 56px,
            rgba(7,85,160,.035) 58px
        ),
        linear-gradient(135deg,#e5faff 0%,#b8e3f2 45%,#d5f2fb 100%);
}

.menu-boton{
    position:absolute;
    top:25px;
    right:30px;
    width:55px;
    height:55px;
    border-radius:50%;
    background:rgba(7,85,160,.9);
    backdrop-filter:blur(10px);
    -webkit-backdrop-filter:blur(10px);
    border:2px solid rgba(255,255,255,.8);
    box-shadow:0 7px 20px rgba(0,55,110,.35);
    cursor:pointer;
    z-index:100;
    display:flex;
    flex-direction:column;
    justify-content:center;
    align-items:center;
    gap:5px;
    transition:all .3s cubic-bezier(.175,.885,.32,1.275);
}

.menu-boton:hover{
    transform:scale(1.08);
    background:#1591c8;
    border-color:white;
}

.menu-boton span{
    width:25px;
    height:3px;
    background:white;
    border-radius:5px;
    transition:all .3s ease;
}

.menu-boton.activo span:nth-child(1){
    transform:translateY(8px) rotate(45deg);
}

.menu-boton.activo span:nth-child(2){
    opacity:0;
}

.menu-boton.activo span:nth-child(3){
    transform:translateY(-8px) rotate(-45deg);
}

.menu-desplegable{
    position:absolute;
    top:90px;
    right:30px;
    width:220px;
    padding:18px;
    background:rgba(255,255,255,.92);
    backdrop-filter:blur(15px);
    -webkit-backdrop-filter:blur(15px);
    border:2px solid rgba(7,85,160,.3);
    border-radius:20px;
    box-shadow:0 15px 35px rgba(0,50,100,.3);
    opacity:0;
    visibility:hidden;
    transform:translateY(-15px) scale(.95);
    transition:all .4s cubic-bezier(.175,.885,.32,1.275);
    z-index:100;
}

.menu-desplegable.abierto{
    opacity:1;
    visibility:visible;
    transform:translateY(0) scale(1);
}

.logo-menu{
    width:68px;
    height:68px;
    margin:3px auto 10px;
    border-radius:50%;
    object-fit:cover;
    border:2px solid #0755A0;
    display:block;
    box-shadow:0 4px 10px rgba(0,0,0,.15);
}

.nombre-clinica{
    text-align:center;
    color:#0755A0;
    font-size:12px;
    font-weight:bold;
    margin-bottom:12px;
    letter-spacing:.5px;
}

.menu-desplegable a{
    display:block;
    text-decoration:none;
    text-align:center;
    color:white;
    background:linear-gradient(135deg,#0755A0,#0b78bd);
    padding:11px;
    margin:8px 0;
    border-radius:12px;
    font-size:12px;
    font-weight:bold;
    transition:all .3s ease;
    box-shadow:0 4px 10px rgba(0,50,100,.15);
}

.menu-desplegable a:hover{
    transform:translateX(5px);
    background:#1591c8;
    box-shadow:0 6px 15px rgba(21,145,200,.4);
}

.encabezado{
    position:relative;
    z-index:5;
    max-width:1200px;
    margin:55px auto 35px;
    padding:20px 28px;
    border-left:8px solid #0755A0;
    background:rgba(255,255,255,.6);
    backdrop-filter:blur(10px);
    -webkit-backdrop-filter:blur(10px);
    border-radius:0 20px 20px 0;
    border-top:1px solid rgba(255,255,255,.7);
    border-right:1px solid rgba(255,255,255,.7);
    border-bottom:1px solid rgba(255,255,255,.7);
    box-shadow:0 8px 25px rgba(0,70,120,.1);
    animation:fadeIn .8s ease-out forwards;
}

.encabezado h1{
    color:#06498d;
    font-size:45px;
    letter-spacing:1.5px;
    text-shadow:1px 1px 2px rgba(255,255,255,.8);
}

.encabezado p{
    color:#305b6f;
    font-size:16px;
    font-weight:bold;
    margin-top:7px;
}

.contenido{
    position:relative;
    z-index:5;
    max-width:1200px;
    margin:auto;
    animation:fadeIn 1s ease-out forwards;
}

.principal{
    display:grid;
    grid-template-columns:38% 62%;
    gap:30px;
    align-items:stretch;
}

.izquierda{
    display:flex;
    flex-direction:column;
    align-items:center;
}

.imagen{
    width:100%;
    aspect-ratio:1/1;
    background:white;
    border:3px solid rgba(7,85,160,.35);
    border-radius:24px;
    overflow:hidden;
    box-shadow:0 12px 28px rgba(0,70,120,.18);
    display:flex;
    align-items:center;
    justify-content:center;
}

.imagen img{
    width:100%;
    height:100%;
    object-fit:contain;
    display:block;
    transition:transform .5s ease;
}

.imagen:hover img{
    transform:scale(1.03);
}

.boton-conocenos{
    width:80%;
    margin-top:25px;
    padding:15px;
    text-align:center;
    text-decoration:none;
    color:white;
    background:linear-gradient(135deg,#06498d,#0b78bd,#159bd0);
    border-radius:15px;
    font-size:14px;
    font-weight:bold;
    letter-spacing:.8px;
    box-shadow:0 7px 18px rgba(0,65,115,.25);
    border:1px solid rgba(255,255,255,.3);
    transition:all .3s ease;
    cursor:pointer;
}

.boton-conocenos:hover{
    transform:translateY(-4px);
    box-shadow:0 11px 25px rgba(0,65,115,.35);
    background:linear-gradient(135deg,#053d78,#0755A0,#21a8d8);
}

.mision-vision{
    min-height:500px;
    background:rgba(255,255,255,.75);
    backdrop-filter:blur(10px);
    -webkit-backdrop-filter:blur(10px);
    border:3px solid rgba(7,85,160,.35);
    border-radius:24px;
    overflow:hidden;
    box-shadow:0 12px 30px rgba(0,70,120,.18);
    display:flex;
    flex-direction:column;
    transition:all .4s ease;
}

.mision-vision:hover{
    border-color:#0755A0;
    box-shadow:0 18px 35px rgba(0,65,115,.24);
}

.seccion{
    flex:1;
    padding:35px 40px;
    display:flex;
    flex-direction:column;
    justify-content:center;
}

.seccion:first-child{
    border-bottom:3px solid rgba(7,85,160,.25);
}

.seccion h2{
    color:#06498d;
    font-size:32px;
    margin-bottom:18px;
    text-align:center;
    letter-spacing:1px;
}

.seccion p{
    color:#4a6d82;
    font-size:15px;
    line-height:1.75;
    text-align:center;
}

.historia{
    display:none;
}

.historia.activa{
    display:block;
    animation:entrada .5s ease forwards;
}

.historia-contenido{
    max-width:1200px;
    margin:auto;
}

.historia-texto{
    background:rgba(255,255,255,.82);
    backdrop-filter:blur(10px);
    -webkit-backdrop-filter:blur(10px);
    border:2px solid rgba(7,85,160,.3);
    border-radius:24px;
    padding:38px;
    box-shadow:0 12px 28px rgba(0,70,120,.15);
    margin-bottom:35px;
}

.historia-texto h2{
    color:#06498d;
    font-size:30px;
    margin-bottom:18px;
    letter-spacing:.5px;
}

.historia-texto p{
    color:#4a6d82;
    font-size:15px;
    line-height:1.8;
    margin-bottom:15px;
}

.historia-texto p:last-child{
    margin-bottom:0;
}

.seccion-extra{
    margin-top:45px;
}

.titulo-extra{
    background:rgba(255,255,255,.72);
    border-left:7px solid #0755A0;
    border-radius:0 18px 18px 0;
    padding:18px 25px;
    margin-bottom:25px;
    box-shadow:0 8px 20px rgba(0,70,120,.12);
}

.titulo-extra h2{
    color:#06498d;
    font-size:28px;
    letter-spacing:.5px;
}

.titulo-extra p{
    color:#4a6d82;
    font-size:14px;
    margin-top:6px;
}

.videos{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:25px;
}

.video-box{
    background:rgba(255,255,255,.85);
    border:2px solid rgba(7,85,160,.3);
    border-radius:22px;
    padding:12px;
    box-shadow:0 10px 25px rgba(0,70,120,.15);
    transition:all .35s ease;
}

.video-box:hover{
    transform:translateY(-6px);
    border-color:#0755A0;
    box-shadow:0 17px 30px rgba(0,70,120,.23);
}

.video-box video{
    width:100%;
    aspect-ratio:16/9;
    display:block;
    border-radius:15px;
    background:#000;
}

.video-titulo{
    color:#06498d;
    text-align:center;
    font-size:16px;
    font-weight:bold;
    margin:13px 5px 5px;
}

.reconocimientos{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:20px;
}

.trofeo{
    background:white;
    border:2px solid rgba(7,85,160,.3);
    border-radius:20px;
    overflow:hidden;
    box-shadow:0 9px 22px rgba(0,70,120,.15);
    transition:all .35s ease;
}

.trofeo:hover{
    transform:translateY(-7px) scale(1.02);
    border-color:#0755A0;
    box-shadow:0 17px 30px rgba(0,70,120,.24);
}

.trofeo img{
    width:100%;
    height:230px;
    object-fit:contain;
    display:block;
    padding:10px;
}

.trofeo p{
    text-align:center;
    color:#06498d;
    font-size:14px;
    font-weight:bold;
    padding:12px;
}

.plantel{
    background:rgba(255,255,255,.82);
    border:2px solid rgba(7,85,160,.3);
    border-radius:24px;
    padding:18px;
    box-shadow:0 12px 28px rgba(0,70,120,.15);
    transition:all .35s ease;
}

.plantel:hover{
    border-color:#0755A0;
    box-shadow:0 18px 34px rgba(0,70,120,.23);
}

.plantel img{
    width:100%;
    max-height:600px;
    object-fit:contain;
    display:block;
    border-radius:16px;
}

.plantel p{
    color:#4a6d82;
    text-align:center;
    font-size:15px;
    line-height:1.7;
    margin:18px auto 5px;
    max-width:900px;
}

.volver{
    display:block;
    width:220px;
    margin:40px auto 0;
    padding:14px;
    text-align:center;
    text-decoration:none;
    color:white;
    background:linear-gradient(135deg,#06498d,#0b78bd,#159bd0);
    border:1px solid rgba(255,255,255,.3);
    border-radius:14px;
    font-size:13px;
    font-weight:bold;
    box-shadow:0 7px 18px rgba(0,65,115,.25);
    cursor:pointer;
    transition:all .3s ease;
}

.volver:hover{
    transform:translateY(-3px);
    box-shadow:0 10px 22px rgba(0,65,115,.35);
    background:linear-gradient(135deg,#053d78,#0755A0,#21a8d8);
}

.galeria{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:25px;
}

.foto{
    height:300px;
    background:white;
    border:2px solid rgba(7,85,160,.3);
    border-radius:22px;
    overflow:hidden;
    box-shadow:0 10px 25px rgba(0,70,120,.15);
    transition:all .35s ease;
    display:flex;
    align-items:center;
    justify-content:center;
}

.foto:hover{
    transform:translateY(-7px) scale(1.02);
    box-shadow:0 18px 32px rgba(0,70,120,.24);
    border-color:#0755A0;
}

.foto img{
    width:100%;
    height:100%;
    object-fit:contain;
    display:block;
}

.foto:hover img{
    transform:scale(1.03);
}

@media(max-width:1000px){

    .reconocimientos{
        grid-template-columns:repeat(2,1fr);
    }
}

@media(max-width:850px){

    .pagina{
        padding:25px 18px 50px;
    }

    .encabezado{
        margin-top:70px;
    }

    .encabezado h1{
        font-size:35px;
    }

    .principal{
        grid-template-columns:1fr;
    }

    .imagen{
        max-width:450px;
    }

    .boton-conocenos{
        max-width:300px;
    }

    .mision-vision{
        min-height:auto;
    }

    .seccion{
        padding:30px 25px;
    }

    .galeria{
        grid-template-columns:1fr;
    }

    .foto{
        height:300px;
    }

    .videos{
        grid-template-columns:1fr;
    }

    .reconocimientos{
        grid-template-columns:1fr;
    }

    .trofeo img{
        height:300px;
    }

    .menu-boton{
        right:18px;
        top:18px;
    }

    .menu-desplegable{
        right:18px;
        top:85px;
    }

    .historia-texto{
        padding:25px;
    }

    .titulo-extra h2{
        font-size:23px;
    }
}
&lt;/style&gt;
&lt;/head&gt;

&lt;body&gt;

&lt;section class=&quot;pagina&quot;&gt;

&lt;button class=&quot;menu-boton&quot; onclick=&quot;abrirMenu(this)&quot;&gt;
&lt;span&gt;&lt;/span&gt;
&lt;span&gt;&lt;/span&gt;
&lt;span&gt;&lt;/span&gt;
&lt;/button&gt;

&lt;nav class=&quot;menu-desplegable&quot; id=&quot;menu&quot;&gt;

&lt;img class=&quot;logo-menu&quot; src=&quot;logo-clinica.jpg.png&quot; alt=&quot;Logo Clínica&quot;&gt;

&lt;div class=&quot;nombre-clinica&quot;&gt;
CLÍNICA SEÑOR DE LAGUNAS
&lt;/div&gt;

&lt;a href=&quot;index.html&quot;&gt;INICIO&lt;/a&gt;
&lt;a href=&quot;servicios.html&quot;&gt;SERVICIOS&lt;/a&gt;
&lt;a href=&quot;especialistas.html&quot;&gt;ESPECIALISTAS&lt;/a&gt;
&lt;a href=&quot;citas.html&quot;&gt;CITAS MÉDICAS&lt;/a&gt;

&lt;/nav&gt;

&lt;div id=&quot;paginaNosotros&quot;&gt;

&lt;div class=&quot;encabezado&quot;&gt;
&lt;h1&gt;NOSOTROS&lt;/h1&gt;
&lt;p&gt;Quiénes somos&lt;/p&gt;
&lt;/div&gt;

&lt;div class=&quot;contenido&quot;&gt;

&lt;div class=&quot;principal&quot;&gt;

&lt;div class=&quot;izquierda&quot;&gt;

&lt;div class=&quot;imagen&quot;&gt;
&lt;img src=&quot;imagen-nosotros.jpg&quot; alt=&quot;Clínica Señor de Lagunas&quot;&gt;
&lt;/div&gt;

&lt;a class=&quot;boton-conocenos&quot; onclick=&quot;mostrarHistoria()&quot;&gt;
CONÓCENOS
&lt;/a&gt;

&lt;/div&gt;

&lt;div class=&quot;mision-vision&quot;&gt;

&lt;div class=&quot;seccion&quot;&gt;

&lt;h2&gt;MISIÓN&lt;/h2&gt;

&lt;p&gt;
Brindar atención médica de calidad, con profesionales capacitados
y un trato humano para cuidar la salud y el bienestar de nuestros
pacientes.
&lt;/p&gt;

&lt;/div&gt;

&lt;div class=&quot;seccion&quot;&gt;

&lt;h2&gt;VISIÓN&lt;/h2&gt;

&lt;p&gt;
Ser una clínica reconocida por su buena atención, confianza y
excelencia, trabajando continuamente para mejorar nuestros
servicios de salud.
&lt;/p&gt;

&lt;/div&gt;

&lt;/div&gt;

&lt;/div&gt;

&lt;/div&gt;

&lt;/div&gt;

&lt;div class=&quot;historia&quot; id=&quot;paginaHistoria&quot;&gt;

&lt;div class=&quot;encabezado&quot;&gt;

&lt;h1&gt;NUESTRA HISTORIA&lt;/h1&gt;

&lt;p&gt;Conoce el origen y el camino de la Clínica Señor de Lagunas.&lt;/p&gt;

&lt;/div&gt;

&lt;div class=&quot;historia-contenido&quot;&gt;

&lt;div class=&quot;historia-texto&quot;&gt;

&lt;h2&gt;La historia de nuestra clínica&lt;/h2&gt;

&lt;p&gt;
Aquí puedes escribir la historia de la Clínica Señor de Lagunas.
Puedes contar cómo comenzó, quiénes participaron en su creación
y cómo fue creciendo con el paso del tiempo.
&lt;/p&gt;

&lt;p&gt;
También puedes agregar los momentos más importantes de la clínica,
sus instalaciones, sus profesionales y el compromiso que tiene
con sus pacientes.
&lt;/p&gt;

&lt;p&gt;
Este texto puedes cambiarlo por toda la información que tú quieras.
&lt;/p&gt;

&lt;/div&gt;

&lt;div class=&quot;galeria&quot;&gt;

&lt;div class=&quot;foto&quot;&gt;
&lt;img src=&quot;historia1.jpg&quot; alt=&quot;Historia 1&quot;&gt;
&lt;/div&gt;

&lt;div class=&quot;foto&quot;&gt;
&lt;img src=&quot;historia2.jpg&quot; alt=&quot;Historia 2&quot;&gt;
&lt;/div&gt;

&lt;div class=&quot;foto&quot;&gt;
&lt;img src=&quot;historia3.jpg&quot; alt=&quot;Historia 3&quot;&gt;
&lt;/div&gt;

&lt;div class=&quot;foto&quot;&gt;
&lt;img src=&quot;historia4.jpg&quot; alt=&quot;Historia 4&quot;&gt;
&lt;/div&gt;

&lt;div class=&quot;foto&quot;&gt;
&lt;img src=&quot;historia5.jpg&quot; alt=&quot;Historia 5&quot;&gt;
&lt;/div&gt;

&lt;div class=&quot;foto&quot;&gt;
&lt;img src=&quot;historia6.jpg&quot; alt=&quot;Historia 6&quot;&gt;
&lt;/div&gt;

&lt;/div&gt;

&lt;div class=&quot;seccion-extra&quot;&gt;

&lt;div class=&quot;titulo-extra&quot;&gt;

&lt;h2&gt;PROMOCIÓN Y COMUNIDAD&lt;/h2&gt;

&lt;p&gt;Compartimos algunos momentos de promoción y participación de nuestra comunidad.&lt;/p&gt;

&lt;/div&gt;

&lt;div class=&quot;videos&quot;&gt;

&lt;div class=&quot;video-box&quot;&gt;

&lt;video controls&gt;
&lt;source src=&quot;promo1.mp4&quot; type=&quot;video/mp4&quot;&gt;
Tu navegador no puede reproducir este video.
&lt;/video&gt;

&lt;div class=&quot;video-titulo&quot;&gt;
Promoción y comunidad
&lt;/div&gt;

&lt;/div&gt;

&lt;div class=&quot;video-box&quot;&gt;

&lt;video controls&gt;
&lt;source src=&quot;promo2.mp4&quot; type=&quot;video/mp4&quot;&gt;
Tu navegador no puede reproducir este video.
&lt;/video&gt;

&lt;div class=&quot;video-titulo&quot;&gt;
Actividades y promoción
&lt;/div&gt;

&lt;/div&gt;

&lt;/div&gt;

&lt;/div&gt;

&lt;div class=&quot;seccion-extra&quot;&gt;

&lt;div class=&quot;titulo-extra&quot;&gt;

&lt;h2&gt;NUESTROS RECONOCIMIENTOS&lt;/h2&gt;

&lt;p&gt;Algunos de los trofeos y reconocimientos obtenidos a lo largo del tiempo.&lt;/p&gt;

&lt;/div&gt;

&lt;div class=&quot;reconocimientos&quot;&gt;

&lt;div class=&quot;trofeo&quot;&gt;
&lt;img src=&quot;trofeo1.jpg&quot; alt=&quot;Trofeo 1&quot;&gt;
&lt;p&gt;Reconocimiento 1&lt;/p&gt;
&lt;/div&gt;

&lt;div class=&quot;trofeo&quot;&gt;
&lt;img src=&quot;trofeo2.jpg&quot; alt=&quot;Trofeo 2&quot;&gt;
&lt;p&gt;Reconocimiento 2&lt;/p&gt;
&lt;/div&gt;

&lt;div class=&quot;trofeo&quot;&gt;
&lt;img src=&quot;trofeo3.jpg&quot; alt=&quot;Trofeo 3&quot;&gt;
&lt;p&gt;Reconocimiento 3&lt;/p&gt;
&lt;/div&gt;

&lt;div class=&quot;trofeo&quot;&gt;
&lt;img src=&quot;trofeo4.jpg&quot; alt=&quot;Trofeo 4&quot;&gt;
&lt;p&gt;Reconocimiento 4&lt;/p&gt;
&lt;/div&gt;

&lt;/div&gt;

&lt;/div&gt;

&lt;div class=&quot;seccion-extra&quot;&gt;

&lt;div class=&quot;titulo-extra&quot;&gt;

&lt;h2&gt;NUESTRO PLANTEL DOCENTE&lt;/h2&gt;

&lt;p&gt;Personas que forman parte de nuestra comunidad y acompañan nuestro trabajo.&lt;/p&gt;

&lt;/div&gt;

&lt;div class=&quot;plantel&quot;&gt;

&lt;img src=&quot;plantel-docente.jpg&quot; alt=&quot;Plantel docente&quot;&gt;

&lt;p&gt;
Nuestro plantel está conformado por profesionales comprometidos
con el trabajo, la responsabilidad y el bienestar de nuestra comunidad.
&lt;/p&gt;

&lt;/div&gt;

&lt;/div&gt;

&lt;button class=&quot;volver&quot; onclick=&quot;volverNosotros()&quot;&gt;
VOLVER A NOSOTROS
&lt;/button&gt;

&lt;/div&gt;

&lt;/div&gt;

&lt;/section&gt;

&lt;script&gt;
function abrirMenu(btn){
    const menu=document.getElementById(&quot;menu&quot;);
    menu.classList.toggle(&quot;abierto&quot;);
    btn.classList.toggle(&quot;activo&quot;);
}

function mostrarHistoria(){
    document.getElementById(&quot;paginaNosotros&quot;).style.display=&quot;none&quot;;
    document.getElementById(&quot;paginaHistoria&quot;).classList.add(&quot;activa&quot;);
    window.scrollTo(0,0);
}

function volverNosotros(){
    document.getElementById(&quot;paginaHistoria&quot;).classList.remove(&quot;activa&quot;);
    document.getElementById(&quot;paginaNosotros&quot;).style.display=&quot;block&quot;;
    window.scrollTo(0,0);
}
&lt;/script&gt;

&lt;/body&gt;
